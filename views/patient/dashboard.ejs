<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="portal-container">
  <!-- Sidebar -->
  <aside class="portal-sidebar shadow-sm">
    <div class="text-center mb-4 pb-3 border-bottom">
      <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center font-weight-bold mx-auto mb-2 display-font" style="width: 54px; height: 54px; font-size: 1.3rem; border: 2px solid var(--border); box-shadow: var(--shadow-sm); background-color: var(--secondary) !important;">
        <%= user.name.split(' ').map(n => n[0]).join('') %>
      </div>
      <h6 class="mb-0 text-dark font-weight-bold" style="letter-spacing:-0.02em; color: var(--secondary) !important;"><%= user.name %></h6>
      <small class="text-muted" style="font-size:0.78rem;"><%= user.email %></small>
    </div>
    
    <ul class="sidebar-nav">
      <li class="sidebar-nav-item">
        <a href="/patient/dashboard" class="sidebar-nav-link active">
          <i class="fa-solid fa-columns"></i> Operations Deck
        </a>
      </li>
      <li class="sidebar-nav-item">
        <a href="/patient/book" class="sidebar-nav-link">
          <i class="fa-solid fa-calendar-plus"></i> Book Consultation
        </a>
      </li>
      <li class="sidebar-nav-item">
        <a href="/patient/appointments" class="sidebar-nav-link">
          <i class="fa-solid fa-clock-history"></i> My Appointment History
        </a>
      </li>
    </ul>
    
    <div class="mt-auto border-top pt-3 text-center">
      <span class="text-muted small d-block">Intelligent Platform</span>
      <span class="text-muted small d-block font-weight-bold" style="font-size:0.7rem; color: var(--accent);">MedQueue v1.5.0</span>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="portal-content">
    <div class="container-fluid p-0">
      
      <!-- Top Title -->
      <div class="row mb-4 align-items-center">
        <div class="col">
          <h2 class="display-font text-dark mb-1 h3" style="color: var(--secondary) !important;">Operations Dashboard</h2>
          <p class="text-muted mb-0 small">Spend time getting treated, not waiting.</p>
        </div>
      </div>
      
      <!-- Stat Widgets -->
      <div class="row g-4 mb-4">
        <div class="col-md-4">
          <div class="med-card d-flex align-items-center border-start border-primary border-4 p-3 bg-white">
            <div class="med-card-icon mb-0 me-3" style="width: 44px; height: 44px; border-radius: 10px; font-size:1.1rem; color: var(--accent); background: rgba(166, 124, 82, 0.05); border-color: rgba(166, 124, 82, 0.15) !important;">
              <i class="fa-solid fa-calendar-check"></i>
            </div>
            <div>
              <h6 class="text-muted mb-1 small font-weight-bold uppercase tracking-wider" style="font-size:0.7rem;">Total Scheduled</h6>
              <h3 class="mb-0 text-dark font-weight-bold display-font" style="color: var(--secondary) !important;"><%= stats.totalBooked %></h3>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="med-card d-flex align-items-center border-start border-success border-4 p-3 bg-white">
            <div class="med-card-icon bg-success-light text-success mb-0 me-3" style="width: 44px; height: 44px; border-radius: 10px; font-size:1.1rem; border-color:var(--success-border) !important;">
              <i class="fa-solid fa-circle-check"></i>
            </div>
            <div>
              <h6 class="text-muted mb-1 small font-weight-bold uppercase tracking-wider" style="font-size:0.7rem;">Visits Completed</h6>
              <h3 class="mb-0 text-dark font-weight-bold display-font" style="color: var(--secondary) !important;"><%= stats.completedCount %></h3>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="med-card d-flex align-items-center border-start border-danger border-4 p-3 bg-white">
            <div class="med-card-icon bg-danger-light text-danger mb-0 me-3" style="width: 44px; height: 44px; border-radius: 10px; font-size:1.1rem; border-color:var(--danger-border) !important;">
              <i class="fa-solid fa-circle-xmark"></i>
            </div>
            <div>
              <h6 class="text-muted mb-1 small font-weight-bold uppercase tracking-wider" style="font-size:0.7rem;">Cancelled Logs</h6>
              <h3 class="mb-0 text-dark font-weight-bold display-font" style="color: var(--secondary) !important;"><%= stats.cancelledCount %></h3>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Live Section -->
      <div class="row g-4">
        <div class="col-lg-8">
          <% if (activeAppointment) { %>
            <div class="med-card mb-4 bg-white p-4">
              <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-4">
                <div>
                  <h5 class="text-dark display-font mb-1 font-weight-bold" style="color: var(--secondary) !important;">Clinical Coordination</h5>
                  <p class="text-muted mb-0 small" style="font-weight: 500;">
                    Consulting: <strong class="text-dark"><%= activeAppointment.doctorName %></strong> (<%= activeAppointment.specialization %>)
                  </p>
                </div>
                <% if (activeAppointment.isEmergency) { %>
                  <span class="med-badge med-badge-emergency"><i class="fa-solid fa-circle-exclamation me-1"></i> Emergency Priority</span>
                <% } else { %>
                  <span class="med-badge med-badge-approved"><i class="fa-solid fa-check me-1"></i> Approved Booking</span>
                <% } %>
              </div>

              <!-- Reassurance and Arrival Recommendation Box -->
              <div class="alert border-0 p-3 mb-4" style="border-radius: var(--radius-md); background-color: rgba(15, 108, 189, 0.04); color: var(--primary); border: 1px solid rgba(15, 108, 189, 0.15) !important;">
                <div class="d-flex align-items-center">
                  <i class="fa-solid fa-bell me-3 fs-5" style="color: var(--accent);"></i>
                  <div class="small">
                    <strong class="d-block mb-1" style="color: var(--secondary);">Arrival Recommendation</strong>
                    <span style="color: var(--text-muted);">We recommend arriving at the clinic <strong>10 minutes before</strong> your estimated wait time. Relax, we will notify you here when the specialist is ready.</span>
                  </div>
                </div>
              </div>

              <!-- Live Break Notice -->
              <div id="pauseBanner" class="alert border-0 p-3 mb-4 d-none" style="border-radius: var(--radius-md); background-color: var(--warning-light); color: var(--warning); border: 1px solid var(--warning-border) !important;">
                <div class="d-flex align-items-center">
                  <span class="pulse-indicator-warning me-3"></span>
                  <div class="small">
                    <strong class="d-block mb-1" style="color: var(--warning);">Queue Temporarily Paused</strong>
                    <span>The specialist is currently on a scheduled break. Average waiting times will adjust as consultations resume.</span>
                  </div>
                </div>
              </div>

              <% if (queueInfo) { %>
                <div class="row g-3 text-center mb-4 pb-3 border-bottom">
                  <div class="col-4 border-end">
                    <div class="p-2">
                      <small class="text-muted font-weight-bold text-uppercase d-block mb-1" style="font-size:0.68rem; tracking-wider">Current Called</small>
                      <h3 class="text-primary font-weight-bold display-font mb-0 h2" id="currentTokenDisplay" style="letter-spacing:-0.03em;">
                        <%= queueInfo.currentToken %>
                      </h3>
                    </div>
                  </div>
                  
                  <div class="col-4 border-end">
                    <div class="p-2">
                      <small class="text-muted font-weight-bold text-uppercase d-block mb-1" style="font-size:0.68rem; tracking-wider">Your Token Pass</small>
                      <h3 class="text-dark font-weight-bold display-font mb-0 h2" style="letter-spacing:-0.03em; color: var(--secondary) !important;">
                        <%= queueInfo.yourToken %>
                      </h3>
                    </div>
                  </div>
                  
                  <div class="col-4">
                    <div class="p-2">
                      <small class="text-muted font-weight-bold text-uppercase d-block mb-1" style="font-size:0.68rem; tracking-wider">Queue Position</small>
                      <h3 class="text-success font-weight-bold display-font mb-0 h2" id="positionDisplay" style="letter-spacing:-0.03em; color: var(--success) !important;">
                        <%= queueInfo.position %>
                      </h3>
                    </div>
                  </div>
                </div>

                <!-- Visual Step Progress Bar -->
                <div class="queue-tracker-container mb-4 px-3 py-2">
                  <div class="queue-progress-bar">
                    <div class="queue-progress-active" id="progressBarActive" style="width: <%= queueInfo.position === 'Current' ? '100%' : (queueInfo.position === 1 ? '50%' : '25%') %>;"></div>
                    
                    <div class="queue-step completed">
                      <div class="queue-step-icon"><i class="fa-solid fa-check"></i></div>
                      <div class="queue-step-label">Scheduled</div>
                    </div>
                    
                    <div class="queue-step <%= queueInfo.position !== 'Current' ? 'active' : 'completed' %>" id="step-queue">
                      <div class="queue-step-icon"><i class="fa-solid fa-hourglass-half"></i></div>
                      <div class="queue-step-label">In Waiting List</div>
                    </div>
                    
                    <div class="queue-step <%= queueInfo.position === 'Current' ? 'active' : '' %>" id="step-call">
                      <div class="queue-step-icon"><i class="fa-solid fa-stethoscope"></i></div>
                      <div class="queue-step-label">Consulting</div>
                    </div>
                  </div>
                </div>

                <div class="bg-light p-3 rounded-4 d-flex justify-content-between align-items-center border">
                  <div class="d-flex align-items-center">
                    <div class="bg-white border rounded-3 d-flex align-items-center justify-content-center me-3" style="width:36px; height:36px; box-shadow:var(--shadow-sm); color: var(--accent);">
                      <i class="fa-solid fa-hourglass-half" style="font-size:0.9rem;"></i>
                    </div>
                    <div>
                      <span class="text-muted small d-block" style="font-size:0.75rem; font-weight:600;">Estimated Waiting Time</span>
                      <strong class="text-dark font-weight-bold" id="waitTimeDisplay" style="font-size:0.95rem; color: var(--secondary) !important;">
                        <%= queueInfo.estWaitingTime %> mins
                      </strong>
                    </div>
                  </div>
                  <div class="text-end text-muted small font-weight-bold">
                    People ahead: <span class="text-dark font-display" id="peopleAheadDisplay" style="font-size:1rem; color: var(--secondary) !important;"><%= queueInfo.peopleAhead %></span>
                  </div>
                </div>
              <% } else { %>
                <!-- Queue has not started yet today -->
                <div class="text-center py-5">
                  <div class="med-card-icon bg-warning-light text-warning mx-auto mb-3" style="width: 50px; height: 50px; border-radius: 50%; border-color:var(--warning-border) !important; color: var(--warning) !important;">
                    <i class="fa-solid fa-clock"></i>
                  </div>
                  <h5 class="text-dark font-weight-bold mb-1" style="color: var(--secondary) !important;">Queue Operations Pending</h5>
                  <p class="text-muted small mx-auto px-3" style="max-width: 420px; line-height:1.6;">
                    Your appointment is booked for today at <strong><%= activeAppointment.timeSlot %></strong>. The live queue tracker will activate once the medical staff begins consulting the first token.
                  </p>
                </div>
              <% } %>
            </div>
          <% } else { %>
            <div class="med-card text-center py-5 bg-white">
              <div class="med-card-icon mx-auto mb-3" style="width: 60px; height: 60px; border-radius: 50%; color: var(--accent); background: rgba(166, 124, 82, 0.05); border-color: rgba(166, 124, 82, 0.15) !important;">
                <i class="fa-solid fa-calendar-check fs-4"></i>
              </div>
              <h4 class="text-dark display-font mb-2" style="color: var(--secondary) !important;">No Scheduled Visits Today</h4>
              <p class="text-muted small mx-auto mb-4" style="max-width: 430px; line-height:1.6;">
                You do not have any pending appointments scheduled for today. Book an upcoming clinic consultation to coordinate your visit.
              </p>
              <a href="/patient/book" class="btn btn-med-primary px-4 py-2">
                <i class="fa-solid fa-calendar-plus me-2"></i> Book Appointment Slot
              </a>
            </div>
          <% } %>
        </div>
        
        <!-- Sidebar Actions Panel -->
        <div class="col-lg-4">
          <!-- Action Hub -->
          <div class="med-card mb-4 p-4 bg-white">
            <h6 class="text-dark font-weight-bold mb-3 border-bottom pb-2 small uppercase tracking-wider" style="color: var(--secondary) !important;">Quick Actions</h6>
            <div class="d-grid gap-3">
              <a href="/patient/book" class="btn btn-med-primary text-start px-3 py-3 d-flex align-items-center" style="background:var(--secondary);">
                <div class="bg-white-10 text-white rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 36px; height: 36px; border: 1px solid rgba(255,255,255,0.15);">
                  <i class="fa-solid fa-calendar-plus" style="color: var(--accent);"></i>
                </div>
                <div>
                  <h6 class="mb-0 text-white font-weight-bold small" style="font-size:0.85rem;">Reserve Appointment</h6>
                  <small class="text-white-50" style="font-size:0.75rem;">Coordinate clinical slots</small>
                </div>
              </a>
              
              <a href="/patient/appointments" class="btn btn-med-secondary text-start px-3 py-3 d-flex align-items-center">
                <div class="bg-primary-light text-primary rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 36px; height: 36px; background: rgba(15, 108, 189, 0.05); border: 1px solid rgba(15, 108, 189, 0.15);">
                  <i class="fa-solid fa-clock-history" style="color: var(--primary);"></i>
                </div>
                <div>
                  <h6 class="mb-0 text-dark font-weight-bold small" style="font-size:0.85rem; color: var(--secondary) !important;">Clinical Records</h6>
                  <small class="text-muted" style="font-size:0.75rem;">Review previous logs</small>
                </div>
              </a>
            </div>
          </div>
          
          <!-- Token Digital Pass Card -->
          <% if (activeAppointment) { %>
            <div class="token-card p-4">
              <div class="token-badge"><i class="fa-solid fa-ticket-simple me-1"></i> Pass Pass Pass</div>
              <h6 class="text-white-50 mb-1 small text-uppercase font-weight-bold" style="font-size:0.68rem; tracking-wider;">Clinical Specialist</h6>
              <h4 class="text-white font-weight-bold mb-4 display-font"><%= activeAppointment.doctorName %></h4>
              
              <div class="border-top border-white-10 pt-3 mb-3">
                <div class="row g-2">
                  <div class="col-6">
                    <small class="text-white-50 d-block small" style="font-size:0.68rem;">SCHEDULED TIME</small>
                    <strong class="text-white" style="font-size:0.9rem;"><%= activeAppointment.timeSlot %></strong>
                  </div>
                  <div class="col-6">
                    <small class="text-white-50 d-block small" style="font-size:0.68rem;">APPOINTMENT DATE</small>
                    <strong class="text-white" style="font-size:0.9rem;"><%= activeAppointment.date %></strong>
                  </div>
                </div>
              </div>
              
              <div class="bg-white-10 p-3 rounded-4 mt-4 text-center border border-white-10 shadow-inner">
                <small class="text-white-50 d-block mb-1 font-weight-bold text-uppercase small" style="font-size:0.65rem; tracking-wider">Your Token Number</small>
                <div class="token-number-display mb-0">
                  T-<%= activeAppointment.tokenNumber.toString().padStart(2, '0') %>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Socket.IO real-time integration -->
<% if (activeAppointment && queueInfo) { %>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const socket = io();
      const doctorId = '<%= activeAppointment.doctor %>';
      const apptId = '<%= activeAppointment._id %>';
      
      // Join Room
      socket.emit('joinQueue', { doctorId });
      
      socket.on('queueUpdated', (data) => {
        const currentTokenSpan = document.getElementById('currentTokenDisplay');
        const positionSpan = document.getElementById('positionDisplay');
        const peopleAheadSpan = document.getElementById('peopleAheadDisplay');
        const waitTimeSpan = document.getElementById('waitTimeDisplay');
        const pauseBanner = document.getElementById('pauseBanner');
        const progressBar = document.getElementById('progressBarActive');
        const stepQueue = document.getElementById('step-queue');
        const stepCall = document.getElementById('step-call');

        // Toggle break warning banner
        if (data.isPaused) {
          pauseBanner.classList.remove('d-none');
        } else {
          pauseBanner.classList.add('d-none');
        }

        // 1. Update current token display
        if (data.currentPatient) {
          currentTokenSpan.textContent = 'T-' + String(data.currentPatient.tokenNumber).padStart(2, '0');
        } else {
          currentTokenSpan.textContent = 'None';
        }

        // 2. Recalculate positions
        if (data.currentPatient && data.currentPatient._id === apptId) {
          positionSpan.textContent = 'Current';
          peopleAheadSpan.textContent = '0';
          waitTimeSpan.textContent = '0 mins (You are being called!)';
          progressBar.style.width = '100%';
          stepQueue.classList.add('completed');
          stepCall.classList.add('active');
        } else {
          const idx = data.activeQueue.findIndex(x => x._id === apptId);
          if (idx !== -1) {
            const pos = idx + 1;
            positionSpan.textContent = pos;
            peopleAheadSpan.textContent = idx;
            waitTimeSpan.textContent = (idx * data.slotDuration) + ' mins';
            progressBar.style.width = pos === 1 ? '50%' : '25%';
            stepQueue.classList.add('active');
            stepQueue.classList.remove('completed');
            stepCall.classList.remove('active');
          } else {
            // Consultation complete / skipped
            window.location.reload();
          }
        }
      });
    });
  </script>
<% } %>

<%- include('../partials/footer') %>
