<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<div class="portal-container">
  <!-- Sidebar -->
  <aside class="portal-sidebar shadow-sm">
    <div class="text-center mb-4 pb-3 border-bottom">
      <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center font-weight-bold mx-auto mb-2 display-font" style="width: 54px; height: 54px; font-size: 1.3rem; border: 2px solid var(--border); box-shadow: var(--shadow-sm); background-color: var(--secondary) !important;">
        AD
      </div>
      <h6 class="mb-0 text-dark font-weight-bold" style="letter-spacing:-0.02em; color: var(--secondary) !important;">System Admin</h6>
      <small class="text-muted" style="font-size:0.78rem;">Operations Console</small>
    </div>
    
    <ul class="sidebar-nav">
      <li class="sidebar-nav-item">
        <a href="/admin/dashboard" class="sidebar-nav-link">
          <i class="fa-solid fa-chart-pie"></i> Metrics Overview
        </a>
      </li>
      <li class="sidebar-nav-item">
        <a href="/admin/doctors" class="sidebar-nav-link">
          <i class="fa-solid fa-user-doctor"></i> Doctor Directory
        </a>
      </li>
      <li class="sidebar-nav-item">
        <a href="/admin/patients" class="sidebar-nav-link active">
          <i class="fa-solid fa-hospital-user"></i> Patient Directory
        </a>
      </li>
    </ul>
  </aside>

  <!-- Content -->
  <main class="portal-content">
    <div class="container-fluid p-0">
      
      <!-- Top Title -->
      <div class="row mb-4 align-items-center">
        <div class="col">
          <h2 class="display-font text-dark mb-1 h3" style="color: var(--secondary) !important;">Patient Directory</h2>
          <p class="text-muted mb-0 small">Inspect demographic profiles, manage account registrations, and audit patient appointment logs.</p>
        </div>
      </div>

      <% if (success) { %>
        <div class="alert border-0 p-3 mb-4 d-flex align-items-center small shadow-sm" role="alert" style="border-radius: var(--radius-md); background-color: var(--success-light); color: var(--success); font-weight: 600; border: 1px solid var(--success-border) !important;">
          <i class="fa-solid fa-circle-check me-2"></i> <%= success %>
        </div>
      <% } %>

      <!-- Patient list card table -->
      <div class="med-card bg-white">
        <div class="mb-4 d-flex flex-wrap gap-2 justify-content-between align-items-center">
          <form action="/admin/patients" method="GET" class="d-flex w-100 w-md-350 gap-2">
            <input type="text" name="search" class="form-control form-med-control" placeholder="Search name, email, phone..." value="<%= search %>">
            <button type="submit" class="btn btn-med-primary px-3 py-2" style="background:var(--secondary);"><i class="fa-solid fa-magnifying-glass"></i></button>
          </form>
          <span class="text-muted small font-weight-bold">Registered Patient Accounts</span>
        </div>

        <div class="table-responsive">
          <table class="table med-table align-middle" id="patientTable">
            <thead>
              <tr>
                <th>Patient Name</th>
                <th>Age</th>
                <th>Gender</th>
                <th>Contact</th>
                <th>Joined Date</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (patients.length === 0) { %>
                <tr>
                  <td colspan="6" class="text-center py-4 text-muted small">No patients registered. Match search term or create accounts.</td>
                </tr>
              <% } else { %>
                <% patients.forEach(pat => { %>
                  <tr>
                    <td class="font-weight-bold text-dark" style="color: var(--secondary) !important;"><%= pat.name %></td>
                    <td><%= pat.age %> Yrs</td>
                    <td><%= pat.gender %></td>
                    <td>
                      <small class="d-block text-dark font-weight-bold" style="font-size:0.85rem; color: var(--secondary) !important;"><%= pat.phone %></small>
                      <small class="text-muted" style="font-size:0.78rem;"><%= pat.email %></small>
                    </td>
                    <td><%= new Date(pat.createdAt || Date.now()).toLocaleDateString() %></td>
                    <td>
                      <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-med-secondary py-1.5 px-3" 
                          onclick="openEditModal('<%= pat._id %>', '<%= pat.name %>', '<%= pat.email %>', '<%= pat.age %>', '<%= pat.gender %>', '<%= pat.phone %>')">
                          <i class="fa-solid fa-edit"></i> Edit
                        </button>
                        
                        <button class="btn btn-sm btn-med-secondary py-1.5 px-3" onclick="viewHistoryModal('<%= pat._id %>')">
                          <i class="fa-solid fa-folder-open"></i> File
                        </button>

                        <form action="/admin/patients/delete" method="POST" onsubmit="return confirm('Are you sure you want to remove this patient? This will permanently delete their portal account and cancel all active bookings.');" class="mb-0">
                          <input type="hidden" name="patientId" value="<%= pat._id %>">
                          <button type="submit" class="btn btn-sm btn-med-secondary text-danger border-danger-subtle py-1.5 px-3" style="background:var(--danger-light);">
                            <i class="fa-solid fa-trash"></i> Delete
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>
</div>

<!-- Modal Dialog: Edit Patient Information -->
<div class="modal fade" id="editPatientModal" tabindex="-1" aria-labelledby="editPatientModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title font-weight-bold display-font text-dark" id="editPatientModalLabel" style="color: var(--secondary) !important;"><i class="fa-solid fa-user-edit text-primary me-2" style="color: var(--accent) !important;"></i> Modify Patient Info</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/admin/patients/edit" method="POST">
        <input type="hidden" name="patientId" id="editPatId">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label text-muted small font-weight-bold">Full Name</label>
            <input type="text" name="name" id="editPatName" class="form-control form-med-control w-100" required>
          </div>
          
          <div class="mb-3">
            <label class="form-label text-muted small font-weight-bold">Email Address</label>
            <input type="email" name="email" id="editPatEmail" class="form-control form-med-control w-100" required>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label text-muted small font-weight-bold">Age</label>
              <input type="number" name="age" id="editPatAge" class="form-control form-med-control w-100" min="1" max="120" required>
            </div>
            
            <div class="col-md-6">
              <label class="form-label text-muted small font-weight-bold">Gender</label>
              <select name="gender" id="editPatGender" class="form-select form-med-control w-100" required style="height: 50px;">
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>

          <div class="mb-2">
            <label class="form-label text-muted small font-weight-bold">Phone Contact</label>
            <input type="tel" name="phone" id="editPatPhone" class="form-control form-med-control w-100" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-med-secondary px-3 py-2" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-med-primary px-4 py-2" style="background:var(--primary);">Save Patient changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal Dialog: Appointment Dossier -->
<div class="modal fade" id="historyModal" tabindex="-1" aria-labelledby="historyModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title font-weight-bold display-font text-dark" id="historyModalLabel" style="color: var(--secondary) !important;"><i class="fa-solid fa-clipboard-user text-primary me-2" style="color: var(--accent) !important;"></i> Patient Appointment Folder</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        
        <!-- Spinner Loader -->
        <div id="modalLoader" class="text-center py-5">
          <div class="spinner-border text-primary" role="status" style="width: 2.5rem; height: 2.5rem; color: var(--accent) !important;"></div>
          <p class="text-muted mt-3 mb-0 small">Retrieving historical appointments...</p>
        </div>

        <div id="modalData" class="d-none">
          <h6 class="text-dark font-weight-bold mb-3 border-bottom pb-2 small uppercase tracking-wider" style="color: var(--secondary) !important;">Appointment Logs Folder</h6>
          <div class="table-responsive" style="max-height: 280px; overflow-y: auto;">
            <table class="table align-middle text-sm">
              <thead>
                <tr class="text-muted border-bottom small">
                  <th>Consulting Specialist</th>
                  <th>Date</th>
                  <th>Slot Time</th>
                  <th>Symptoms / Notes</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody id="apptLogsTableBody">
                <!-- Dynamically generated -->
              </tbody>
            </table>
          </div>
        </div>

      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-med-secondary px-4 py-2" data-bs-dismiss="modal">Close Folder</button>
      </div>
    </div>
  </div>
</div>

<script>
  let editPatientModal = null;
  let historyModal = null;

  document.addEventListener('DOMContentLoaded', () => {
    editPatientModal = new bootstrap.Modal(document.getElementById('editPatientModal'));
    historyModal = new bootstrap.Modal(document.getElementById('historyModal'));
  });

  // Pre-fill Edit Patient
  function openEditModal(id, name, email, age, gender, phone) {
    document.getElementById('editPatId').value = id;
    document.getElementById('editPatName').value = name;
    document.getElementById('editPatEmail').value = email;
    document.getElementById('editPatAge').value = age;
    document.getElementById('editPatGender').value = gender;
    document.getElementById('editPatPhone').value = phone;
    editPatientModal.show();
  }

  // Load Patient Appointment Logs
  async function viewHistoryModal(patientId) {
    historyModal.show();
    
    const loader = document.getElementById('modalLoader');
    const dataPanel = document.getElementById('modalData');
    
    loader.classList.remove('d-none');
    dataPanel.classList.add('d-none');

    try {
      const response = await fetch(`/doctor/patient-history/${patientId}`);
      const data = await response.json();

      if (response.ok) {
        const tbody = document.getElementById('apptLogsTableBody');
        tbody.innerHTML = '';

        if (data.appointments.length === 0) {
          tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3 small">No appointments logged in folder.</td></tr>';
        } else {
          data.appointments.forEach(appt => {
            const badgeClass = appt.status === 'completed' ? 'bg-success-light text-success' 
                             : appt.status === 'cancelled' || appt.status === 'rejected' ? 'bg-danger-light text-danger'
                             : 'bg-warning-light text-warning';

            tbody.innerHTML += `
              <tr class="border-bottom border-light">
                <td class="font-weight-bold text-dark small">\${appt.doctorName}</td>
                <td class="small">\${appt.date}</td>
                <td class="small">\${appt.timeSlot}</td>
                <td class="text-muted small" style="max-width: 240px;">\${appt.symptoms || 'Routine clinic checkup'}</td>
                <td><span class="badge \${badgeClass} text-uppercase font-weight-bold" style="font-size:0.68rem; border-radius:10px;">\${appt.status}</span></td>
              </tr>
            `;
          });
        }

        loader.classList.add('d-none');
        dataPanel.classList.remove('d-none');
      } else {
        alert('Failed to retrieve patient logs.');
      }
    } catch (err) {
      console.error('Error fetching logs:', err);
      alert('Error fetching patient records.');
    }
  }
</script>

<%- include('../partials/footer') %>
