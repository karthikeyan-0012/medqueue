<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- Hero Section with Premium Minimalist Backdrop -->
<section class="hero-section" style="background-color: var(--bg);">
  <div class="hero-shape-1"></div>
  <div class="hero-shape-2"></div>
  <div class="container position-relative" style="z-index: 10;">
    <div class="row align-items-center min-vh-75 pt-lg-5">
      <div class="col-lg-6 slide-up">
        <span class="badge bg-white text-secondary border border-subtle px-3 py-2 rounded-pill font-weight-bold mb-3 small uppercase tracking-wider" style="color: var(--accent) !important; border-color: var(--border) !important;">
          <i class="fa-solid fa-notes-medical me-1"></i> Patient Experience Platform
        </span>
        <h1 class="hero-title display-font font-weight-extrabold mb-3">
          Spend time getting treated, <span class="text-gradient">not waiting.</span>
        </h1>
        <p class="lead text-muted mb-4 fs-5" style="max-width: 530px; font-weight: 500; line-height: 1.6; color: var(--text-muted) !important;">
          MedQueue optimizes clinical coordination and waiting rooms. Reserve verified slots, track queue positions in real time, and arrive precisely when the doctor is ready for you.
        </p>
        <div class="d-flex flex-wrap gap-3">
          <% if (!user) { %>
            <a href="/login?role=patient" class="btn btn-med-primary px-4 py-3">
              <i class="fa-solid fa-calendar-check me-2"></i> Book Appointment Now
            </a>
            <a href="/register" class="btn btn-med-secondary px-4 py-3">
              <i class="fa-solid fa-user-plus me-2"></i> Create Patient Account
            </a>
          <% } else { %>
            <a href="/<%= user.role %>/dashboard" class="btn btn-med-primary px-4 py-3">
              <i class="fa-solid fa-columns me-2"></i> Open Portal Dashboard
            </a>
          <% } %>
        </div>
      </div>
      
      <!-- Premium Hero Image -->
      <div class="col-lg-6 mt-5 mt-lg-0 text-center fade-in">
        <div class="position-relative d-inline-block">
          <img src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=600&q=80" alt="Hospital UI" class="img-fluid rounded-4 shadow-md border" style="max-width: 88%; border-color: var(--border) !important;">
          
          <!-- Glowing Floating Mini Cards -->
          <div class="med-card position-absolute d-none d-md-flex align-items-center bg-white p-3 shadow-md border" style="bottom: 30px; left: -40px; border-radius: var(--radius-md); width: 260px; border-color: var(--border) !important;">
            <div class="med-card-icon bg-success-light text-success me-3 mb-0" style="width: 40px; height: 40px; border-radius: 10px; font-size: 1.1rem; border-color: var(--success-border) !important;">
              <i class="fa-solid fa-circle-check"></i>
            </div>
            <div class="text-start">
              <h6 class="mb-0 text-dark font-weight-bold small">Live Queue Pulse</h6>
              <small class="text-success font-weight-bold"><i class="fa-solid fa-circle-play me-1"></i> Specialist is Active</small>
            </div>
          </div>
          
          <div class="med-card position-absolute d-none d-md-flex align-items-center bg-white p-3 shadow-md border" style="top: 50px; right: -30px; border-radius: var(--radius-md); width: 235px; border-color: var(--border) !important;">
            <div class="med-card-icon bg-warning-light text-warning me-3 mb-0" style="width: 40px; height: 40px; border-radius: 10px; font-size: 1.1rem; border-color: var(--warning-border) !important;">
              <i class="fa-solid fa-clock"></i>
            </div>
            <div class="text-start">
              <h6 class="mb-0 text-dark font-weight-bold small">Token Call T-03</h6>
              <small class="text-muted">Est. wait: ~ 10 mins</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Stats Counters Grid -->
<section class="py-5 bg-white border-top border-bottom">
  <div class="container">
    <div class="row text-center g-4">
      <div class="col-6 col-lg-3">
        <div class="counter-box">
          <div class="counter-number" style="color: var(--secondary);"><span style="color: var(--accent);">15k</span>+</div>
          <p class="text-muted small font-weight-bold mb-0 text-uppercase tracking-wider">Patients Coordinated</p>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="counter-box">
          <div class="counter-number" style="color: var(--secondary);"><span style="color: var(--accent);">50</span>+</div>
          <p class="text-muted small font-weight-bold mb-0 text-uppercase tracking-wider">Board Specialists</p>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="counter-box">
          <div class="counter-number" style="color: var(--secondary);">&lt; <span style="color: var(--accent);">5</span> min</div>
          <p class="text-muted small font-weight-bold mb-0 text-uppercase tracking-wider">Average Wait Time</p>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="counter-box">
          <div class="counter-number" style="color: var(--secondary);"><span style="color: var(--accent);">99.8</span>%</div>
          <p class="text-muted small font-weight-bold mb-0 text-uppercase tracking-wider">On-Time Accuracy</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Services Panel Overhaul -->
<section id="services" class="section-padding bg-light">
  <div class="container">
    <div class="text-center mb-5 max-width-600 mx-auto">
      <span class="text-secondary font-weight-bold text-uppercase small tracking-wider" style="color: var(--accent) !important;">Patient Experience</span>
      <h2 class="display-font text-dark mt-2 mb-3 h1" style="color: var(--secondary) !important;">Redefining Clinic Workflows</h2>
      <p class="text-muted">Replacing chaotic waiting lobbies with active, digital queue transparency and dynamic scheduling.</p>
    </div>
    
    <div class="row g-4">
      <div class="col-md-4">
        <div class="med-card h-100 p-4 bg-white">
          <div class="med-card-icon" style="color: var(--accent); background: rgba(166, 124, 82, 0.05); border-color: rgba(166, 124, 82, 0.15) !important;">
            <i class="fa-solid fa-calendar-days"></i>
          </div>
          <h5 class="mb-3 font-weight-bold" style="color: var(--secondary);">OPD Slot Booking</h5>
          <p class="text-muted small">Select specialties, review real-time availability calendars, choose preferred timeslots, and secure bookings in under 60 seconds.</p>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="med-card h-100 p-4 bg-white">
          <div class="med-card-icon" style="color: var(--primary); background: rgba(15, 108, 189, 0.05); border-color: rgba(15, 108, 189, 0.15) !important;">
            <i class="fa-solid fa-ticket"></i>
          </div>
          <h5 class="mb-3 font-weight-bold" style="color: var(--secondary);">Live Digital Passes</h5>
          <p class="text-muted small">Generate active digital tokens. No printouts required—monitor your live queue position and estimated wait times from any device.</p>
        </div>
      </div>
      
      <div class="col-md-4">
        <div class="med-card h-100 p-4 bg-white">
          <div class="med-card-icon" style="color: var(--danger); background: var(--danger-light); border-color: var(--danger-border) !important;">
            <i class="fa-solid fa-triangle-exclamation"></i>
          </div>
          <h5 class="mb-3 font-weight-bold" style="color: var(--secondary);">Priority Elevate</h5>
          <p class="text-muted small">Emergency patients are elevated to the front of the queue by staff. The system instantly recalculates wait times for subsequent slots.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Detailed Feature Layouts -->
