<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="auth-bg">
  <div class="auth-card fade-in">
    <div class="text-center mb-4">
      <a class="navbar-brand text-gradient d-flex justify-content-center align-items-center mb-3 font-weight-bold" href="/" style="font-size: 1.6rem; letter-spacing: -0.04em;">
        <i class="fa-solid fa-notes-medical text-primary me-2" style="color: var(--accent) !important;"></i>
        <span>MedQueue</span>
      </a>
      <h4 class="text-dark font-weight-bold mb-1" id="loginHeader" style="letter-spacing: -0.03em; color: var(--secondary) !important;">Patient Portal Sign In</h4>
      <p class="text-muted small">Spend time getting treated, not waiting.</p>
    </div>

    <% if (error) { %>
      <div class="alert border-0 p-3 mb-4 d-flex align-items-center small shadow-sm" role="alert" style="border-radius: var(--radius-md); background-color: var(--danger-light); color: var(--danger); font-weight: 600; border: 1px solid var(--danger-border) !important;">
        <i class="fa-solid fa-circle-exclamation me-2"></i> <%= error %>
      </div>
    <% } %>

    <% if (success) { %>
      <div class="alert border-0 p-3 mb-4 d-flex align-items-center small shadow-sm" role="alert" style="border-radius: var(--radius-md); background-color: var(--success-light); color: var(--success); font-weight: 600; border: 1px solid var(--success-border) !important;">
        <i class="fa-solid fa-circle-check me-2"></i> <%= success %>
      </div>
    <% } %>

    <div class="role-tab-container">
      <div class="role-tab <%= role === 'patient' ? 'active' : '' %>" onclick="switchRole('patient')">
        <i class="fa-solid fa-user me-1"></i> Patient
      </div>
      <div class="role-tab <%= role === 'doctor' ? 'active' : '' %>" onclick="switchRole('doctor')">
        <i class="fa-solid fa-user-doctor me-1"></i> Doctor
      </div>
      <div class="role-tab <%= role === 'admin' ? 'active' : '' %>" onclick="switchRole('admin')">
        <i class="fa-solid fa-user-shield me-1"></i> Admin
      </div>
    </div>

    <form action="/login" method="POST" id="loginForm">
      <input type="hidden" name="role" id="roleInput" value="<%= role %>">
      
      <div class="mb-3">
        <label class="form-label text-muted small font-weight-bold">Email Address</label>
        <div class="input-group">
          <span class="input-group-text border-end-0 bg-white" style="border-radius: var(--radius-md) 0 0 var(--radius-md); border-color: var(--border);"><i class="fa-solid fa-envelope text-muted"></i></span>
          <input type="email" name="email" class="form-control form-med-control border-start-0 ps-0 w-100" placeholder="Your email" required style="border-radius: 0 var(--radius-md) var(--radius-md) 0;">
        </div>
      </div>

      <div class="mb-4">
        <div class="d-flex justify-content-between mb-1">
          <label class="form-label text-muted small font-weight-bold mb-0">Password</label>
          <a href="#" class="small text-decoration-none" style="font-size:0.82rem; font-weight: 700; color: var(--accent);">Forgot Password?</a>
        </div>
        <div class="input-group">
          <span class="input-group-text border-end-0 bg-white" style="border-radius: var(--radius-md) 0 0 var(--radius-md); border-color: var(--border);"><i class="fa-solid fa-lock text-muted"></i></span>
          <input type="password" name="password" class="form-control form-med-control border-start-0 ps-0 w-100" placeholder="••••••••" required style="border-radius: 0 var(--radius-md) var(--radius-md) 0;">
        </div>
      </div>

      <button type="submit" class="btn btn-med-primary w-100 py-3 mb-3 font-weight-bold" id="submitBtn" style="border-radius: var(--radius-md);">
        Sign In to Portal
      </button>

      <div class="text-center mt-3" id="signupPrompt">
        <span class="text-muted small">New to MedQueue? </span>
        <a href="/register" class="small text-decoration-none font-weight-bold" style="color: var(--primary);">Create Patient Account</a>
      </div>
    </form>
  </div>
</div>

<script>
  function switchRole(role) {
    // Update active tab class
    document.querySelectorAll('.role-tab').forEach(tab => {
      tab.classList.remove('active');
    });
    event.currentTarget.classList.add('active');

    // Update input and heading text
    document.getElementById('roleInput').value = role;
    
    const header = document.getElementById('loginHeader');
    const signupPrompt = document.getElementById('signupPrompt');
    const submitBtn = document.getElementById('submitBtn');
    
    // Customize page colors dynamically to look extremely premium
    if (role === 'patient') {
      header.textContent = 'Patient Portal Sign In';
      signupPrompt.style.display = 'block';
      submitBtn.style.background = 'var(--secondary)';
      submitBtn.style.color = '#fff';
    } else if (role === 'doctor') {
      header.textContent = 'Doctor Console Access';
      signupPrompt.style.display = 'none';
      submitBtn.style.background = 'var(--success)';
      submitBtn.style.color = '#fff';
    } else if (role === 'admin') {
      header.textContent = 'Admin Command Center';
      signupPrompt.style.display = 'none';
      submitBtn.style.background = 'var(--danger)';
      submitBtn.style.color = '#fff';
    }
  }

  // Pre-select correct role tab on window load
  window.onload = function() {
    const activeRole = document.getElementById('roleInput').value;
    const tabIndex = activeRole === 'patient' ? 0 : activeRole === 'doctor' ? 1 : 2;
    const targetTab = document.querySelectorAll('.role-tab')[tabIndex];
    if (targetTab) {
      targetTab.click();
    }
  }
</script>

<%- include('partials/footer') %>
